# docker-compose.yml configuration — copy to `.env` and fill in.
# start.sh does this for you (and generates the two secrets below) on first run.
#
# This is the containerized deployment path. The bare-metal path (systemd +
# nginx, no Docker) is documented in deploy/DEPLOY.md and is what actually
# runs in production today — see that file if you're targeting the existing
# clausechain.zai.bd server rather than a fresh Docker host.

# --- Postgres ---
POSTGRES_DB=clausechain
POSTGRES_USER=clausechain
POSTGRES_PASSWORD=__CHANGE_ME__

# --- Django ---
# Generate with: openssl rand -hex 48   (must differ from each other)
DJANGO_SECRET_KEY=__CHANGE_ME__
JWT_SIGNING_KEY=__CHANGE_ME__
DEBUG=False
ENVIRONMENT=production
# http:// until TLS is terminated in front of nginx (e.g. a load balancer,
# Cloudflare, or your own certbot sidecar — not included in this compose file).
APP_ORIGIN=http://localhost
PUBLIC_APP_URL=http://localhost
TRUST_X_FORWARDED_PROTO=1
# Must stay False until something in front of nginx actually terminates TLS —
# Django defaults this True in production and would 301 every request to a
# https:// nothing is listening on. Flip to true once you add real TLS.
SECURE_SSL_REDIRECT=False

# --- Engine ---
# hybrid_accuracy (Path B, needs OPENAI_API_KEY) or local_fallback (Path A, key-free)
CLAUSECHAIN_PROVIDER_PROFILE=local_fallback
OPENAI_API_KEY=
GRAPH_BACKEND=sqlite
EMBEDDING_PROVIDER=openai
OCR_PROVIDER=local
OCR_ENDPOINT=
OCR_API_KEY=

# --- Optional integrations (leave blank to disable the feature) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
