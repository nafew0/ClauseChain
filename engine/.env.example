# Provider profile: hybrid_accuracy (Path B — cloud reasoning, needs OPENAI_API_KEY)
# or local_fallback (Path A — key-free Ollama + SQLite, the sandbox-safe default)
CLAUSECHAIN_PROVIDER_PROFILE=hybrid_accuracy

# OpenAI
OPENAI_API_KEY=
OPENAI_BULK_MODEL=gpt-5.4-nano
OPENAI_HIGH_REASONING_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google / Gemini
GEMINI_API_KEY=
GEMINI_BULK_MODEL=gemini-3-flash-preview
GEMINI_HIGH_REASONING_MODEL=

# Embeddings: 'openai' (cloud, needs OPENAI_API_KEY) or 'bge_m3' (local) — Path B block in models.yaml
EMBEDDING_PROVIDER=openai

# OCR: 'local' (placeholder) or 'remote_paddle' (PaddleOCR service on another machine —
# either scripts/paddle_ocr_server.py or any PaddleHub-style server; full /ocr URL is fine)
OCR_PROVIDER=local
OCR_ENDPOINT=http://localhost:8089
OCR_API_KEY=
# Optional scanned-page primary. Must expose the same token+bbox HTTP contract;
# proof-incomplete VL output falls back to PaddleOCR, then Tesseract.
OCR_VL_ENDPOINT=
OCR_VL_API_KEY=
OCR_VL_REQUEST_FORMAT=multipart

# Unlimited-OCR (self-hosted, OpenAI-compatible vLLM endpoint; image input — PDFs are rasterized per page)
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=unlimited-ocr

# Local OCR placeholder
LOCAL_OCR_MODEL=

# Graph backend: sqlite (default, zero setup — the judged path) or neo4j (optional demo swap)
GRAPH_BACKEND=sqlite

# Local Neo4j (only needed when GRAPH_BACKEND=neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Local open-weights LLM — the app's "Local" run mode (profile local_openweights).
# Any OpenAI-compatible server: vLLM, Ollama /v1, a hosted open-weights API.
LOCALAI_ENDPOINT=
LOCALAI_API_KEY=
LOCALAI_MODEL=                 # id the server expects (vLLM --served-model-name)
LOCALAI_MODEL_LABEL=           # real weights, recorded as model_version (e.g. unsloth/Qwen3.8-27B-NVFP4)
# LOCALAI_TIMEOUT_S=300
# LOCALAI_CONCURRENCY=3          # parallel requests to the local server (hybrid: CLAUSECHAIN_LLM_CONCURRENCY=6)
# LOCALAI_ENABLE_THINKING=0      # 1 = let Qwen3-style models reason before answering (much slower)
# Local-mode embeddings: bge_m3 (default, on the run host) or openai_compatible (a self-hosted server)
# LOCALAI_EMBED_PROVIDER=openai_compatible
# LOCALAI_EMBED_ENDPOINT=
# LOCALAI_EMBED_API_KEY=       # blank = reuse LOCALAI_API_KEY
# LOCALAI_EMBED_MODEL=BAAI/bge-m3
