# ClauseChain backend — development image.
#
# Hot reload happens via the bind mount in ../docker-compose.dev.yml
# (./backend:/srv/clausechain/backend); the COPY below only makes this image
# buildable/runnable standalone (`docker build` + `docker run` without
# compose). Mirrors backend/README.md's local setup (pip install -r
# requirements.txt; manage.py migrate/runserver) inside a container instead
# of a host venv.
#
# WORKDIR mirrors the production layout (backend/Dockerfile: everything
# under /srv/clausechain) so ENGINE_ROOT in clausechain/settings.py resolves
# ../engine correctly when docker-compose.dev.yml mounts it alongside this
# directory — no ENGINE_ROOT override needed.
#
# Unlike backend/Dockerfile (production), this image does NOT build the
# engine's own FULL .venv — that adds a multi-GB PyTorch/BGE-M3 install to
# every dev rebuild for a capability (launching NEW engine runs) that isn't
# needed for backend/frontend development. See docker-compose.dev.yml's top
# comment and its engine-venv-init service: it builds a small, real
# engine/.venv (PyYAML + openpyxl + pydantic — no torch/numpy/pymupdf) into a
# named volume overlaid at that exact path, at startup rather than build
# time, because a Docker volume can't be populated during `docker build`.
# That covers `manage.py engine_refresh` AND every allowlisted engine action
# (backend/workspace/engine_worker.py) EXCEPT run_pipeline/build_*_corpus,
# which need the full ML stack and stay out of scope here.
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv/clausechain/backend

COPY requirements.txt .
RUN pip install --no-cache-dir -U pip \
    && pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
