{
  "_doc": "Engine-action allowlist (App Dev Plan Rev B #4). The worker executes ONLY these actions, argv built from the template with validated params, shell=False, cwd=ENGINE_ROOT, stdout/stderr captured to the EngineAction row with a SHA-256 of each produced artifact. Anything not listed is refused.",
  "actions": {
    "refresh_payload": {
      "_doc": "Refresh snapshot: rebuilds review inputs (refuter, consolidation, zone-3, review bundle, champion report) for hybrid runs whose output is newer than submission/consolidated.json, then exports ui_export.zip; the worker imports the snapshot afterwards.",
      "argv": [
        ".venv/bin/python",
        "scripts/prepare_review_inputs.py",
        "--out",
        "ui_export.zip"
      ],
      "params": {},
      "timeout_s": 3600,
      "exclusive": true
    },
    "apply_decisions": {
      "argv": [
        ".venv/bin/python",
        "scripts/apply_decisions.py",
        "--domain",
        "{domain}",
        "--input",
        "{input_file}"
      ],
      "params": {
        "domain": {
          "enum": [
            "findings",
            "recall",
            "zone3"
          ]
        },
        "input_file": {
          "pattern": "^/srv/clausechain/backend/var/decision_batches/[A-Za-z0-9_.-]+\\.json$"
        }
      },
      "optional_flags": {
        "expected_sha": [
          "--expected-sha",
          "{expected_sha}"
        ],
        "bundle_after": [
          "--bundle-after"
        ]
      },
      "timeout_s": 60
    },
    "export_bundle": {
      "argv": [
        ".venv/bin/python",
        "-c",
        "import sys; sys.path.insert(0,'.'); from scripts.apply_decisions import export_bundle; from pathlib import Path; import json; print(json.dumps(export_bundle(Path('.'))))"
      ],
      "params": {},
      "timeout_s": 60
    },
    "replay": {
      "argv": [
        ".venv/bin/python",
        "scripts/submission_replay.py"
      ],
      "params": {},
      "optional_flags": {
        "bundle": [
          "--bundle",
          "{bundle}"
        ]
      },
      "param_constraints": {
        "bundle": {
          "pattern": "^data/review/bundles/[A-Za-z0-9-]+$"
        }
      },
      "timeout_s": 300
    },
    "champion_validate": {
      "argv": [
        ".venv/bin/python",
        "scripts/champion_validate.py"
      ],
      "params": {},
      "timeout_s": 900
    },
    "run_pipeline": {
      "_doc": "superuser-only at the API layer (G4); spend cap is the backstop. provider_profile/out_prefix come from the app's run mode: hybrid -> hybrid_accuracy/final (final_r2 for the round-2 economies the snapshot imports as final_r2_*), local -> local_openweights/local",
      "argv": [
        ".venv/bin/python",
        "run.py",
        "--economy",
        "{economy}",
        "--pillar",
        "{pillar}",
        "--provider-profile",
        "{provider_profile}",
        "--out",
        "outputs/{out_prefix}_{cc}_p{pillar}"
      ],
      "params": {
        "economy": {
          "enum": [
            "Singapore",
            "Malaysia",
            "Australia",
            "Thailand",
            "India",
            "Indonesia"
          ]
        },
        "pillar": {
          "enum": [
            "6",
            "7"
          ]
        },
        "cc": {
          "enum": [
            "si",
            "ma",
            "au",
            "th",
            "in",
            "id"
          ]
        },
        "provider_profile": {
          "enum": [
            "hybrid_accuracy",
            "local_openweights"
          ]
        },
        "out_prefix": {
          "enum": [
            "final",
            "final_r2",
            "local"
          ]
        }
      },
      "timeout_s": 3600,
      "exclusive": true
    },
    "build_sg_corpus": {
      "argv": [
        ".venv/bin/python",
        "scripts/build_sg_corpus.py"
      ],
      "params": {},
      "timeout_s": 3600,
      "exclusive": true
    },
    "build_my_corpus": {
      "argv": [
        ".venv/bin/python",
        "scripts/build_my_corpus.py"
      ],
      "params": {},
      "timeout_s": 3600,
      "exclusive": true
    },
    "build_au_corpus": {
      "argv": [
        ".venv/bin/python",
        "scripts/build_au_corpus.py"
      ],
      "params": {},
      "timeout_s": 3600,
      "exclusive": true
    },
    "build_r2_corpus": {
      "_doc": "Round-2 generic corpus build (pack-driven; script lands with the R2 build step)",
      "argv": [
        ".venv/bin/python",
        "scripts/build_seeds_corpus.py",
        "--economy",
        "{economy}"
      ],
      "params": {
        "economy": {
          "enum": [
            "Thailand",
            "India",
            "Indonesia"
          ]
        }
      },
      "timeout_s": 7200,
      "exclusive": true
    }
  }
}
